# Porta do servidor
PORT=4000

# Fonte de dados: json | sqlite | sqlserver
DATA_SOURCE=json

# Diretorio dos arquivos JSON (usado quando DATA_SOURCE=json)
DATA_DIR=src/data

# --- SQL Server (quando DATA_SOURCE=sqlserver) ---
# SQLSERVER_HOST=servidor-corporativo
# SQLSERVER_DB=RPA_OPS
# SQLSERVER_USER=rpa_app
# SQLSERVER_PASSWORD=

# --- Control Room (Automation Anywhere) ---
# CR_MODE=mock roda com o JSON local (funciona sem rede/credencial).
# CR_MODE=live chama o Control Room de verdade (precisa estar na rede/VPN da sua empresa).
CR_MODE=mock
# CR_URL=https://seu-control-room.automationanywhere.digital
# CR_USERNAME=DOMINIO\usuario
# CR_API_KEY=

# --- Teams: notifica quando um robo MONITORADO falha ---
# Webhook do Power Automate (segredo - nunca commitar valor real aqui).
# NOTIFY_TEAMS_LIVE=false (default) so loga no console o que enviaria.
# NOTIFY_TEAMS_LIVE=true dispara de verdade pro Teams.
# TEAMS_WEBHOOK_URL=
NOTIFY_TEAMS_LIVE=false

# --- Teams: notifica quando um chamado NOVO abre no ServiceNow ---
# Webhook SEPARADO do de cima - outro fluxo no Power Automate.
# TEAMS_SERVICENOW_WEBHOOK_URL=
NOTIFY_TEAMS_SERVICENOW_LIVE=false

# --- ServiceNow (chamados das filas que o time de sustentacao monitora) ---
# SERVICENOW_MODE=mock roda com dado local. SERVICENOW_MODE=live chama a API de verdade.
SERVICENOW_MODE=mock
# SERVICENOW_URL=https://suaempresa.service-now.com
# SERVICENOW_CLIENT_ID=
# SERVICENOW_CLIENT_SECRET=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=
# sys_id dos assignment_group das filas monitoradas, separados por virgula
# (pegue na URL do registro do grupo: Assignment groups > abrir o grupo > sys_id na URL).
# SERVICENOW_ASSIGNMENT_GROUPS=sys_id_do_grupo_1,sys_id_do_grupo_2
# SERVICENOW_GRANT_TYPE=password roda com password+client_credentials (default).
# SERVICENOW_GRANT_TYPE=client_credentials roda so com client_id+client_secret.
# SERVICENOW_AUTH_MODE=oauth (default) usa /oauth_token.do. SERVICENOW_AUTH_MODE=basic
# usa Basic Auth direto (username/password) - usar se o client OAuth nao funcionar.

# --- Log de chamadas (Control Room / ServiceNow / requisicoes do navegador) ---
# Ligado por padrao: console + backend/logs/calls.log + GET /api/debug/calls
# (so metadados: metodo, caminho, status, tempo, tamanho - nunca corpo/token/senha).
# LOG_CALLS=false desliga.
# LOG_CALLS=true
