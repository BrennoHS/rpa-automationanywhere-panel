# Deixe true para rodar o frontend sozinho com dados mockados.
# Coloque false para consumir o backend real.
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:4000/api

# Username que SUA automação de detecção de falha usa pra abrir chamado
# sozinha no ServiceNow - identifica chamados "proativos" (automação) vs
# "reativos" (pessoa abriu na mão) no painel e no export.
# VITE_PROACTIVE_REQUESTER=svc.rpa.bot
